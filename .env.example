# En desarrollo usa el proxy de Vite para conservar las cookies de sesion
# cuando la app se abre desde localhost o 127.0.0.1.
VITE_BACKEND_URL=/

# Google Picker: credenciales publicas del proyecto de Google Cloud.
# El token OAuth se mantiene solamente en memoria y usa el alcance drive.file.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
