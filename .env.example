# Variable principal: URL del backend. En produccion, usar la URL publica de Railway.
VITE_BACKEND_URL=http://localhost:3000
# Alias/fallback de VITE_BACKEND_URL, se usa solo si esta no esta definida.
# VITE_API_BASE_URL=

# Google Picker: credenciales publicas del proyecto de Google Cloud.
# El token OAuth se mantiene solamente en memoria y usa el alcance drive.file.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
